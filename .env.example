# ===========================================
# Futmondo Analytics — Variables de Entorno
# ===========================================
# 1. Copia este archivo:  cp .env.example .env
# 2. Rellena tus credenciales
# 3. Arranca:             docker compose up --build
# ===========================================

# --- Credenciales Futmondo (obligatorias) ---
FUTMONDO_EMAIL=tu-email@ejemplo.com
FUTMONDO_PASSWORD=tu-password

# --- API Futmondo ---
BASE_URL=https://api.futmondo.com
CHAMPIONSHIP_ID=592416daa3a2dd871a7a9956

# --- Base de datos ---
DATABASE_TYPE=sqlite
DATABASE_PATH=/app/data/futmondo_data.db

# --- Servidor API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Caché y análisis ---
CACHE_DURATION_HOURS=24
MAX_PLAYERS_TO_ANALYZE=600
MIN_TRANSACTIONS_FOR_ANALYSIS=1
REQUEST_DELAY_SECONDS=0.1
