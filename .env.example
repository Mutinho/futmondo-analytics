# ============================================
# Futmondo API - Variables de Entorno
# ============================================
# Copia este archivo a .env y edita con tus valores
# cp .env.example .env

# ============================================
# Credenciales de Futmondo API
# ============================================
FUTMONDO_EMAIL=your-email
FUTMONDO_PASSWORD=your-password.

# ============================================
# Configuración de API
# ============================================
BASE_URL=https://api.futmondo.com
CHAMPIONSHIP_ID=your-championship-id

# ============================================
# Configuración de Base de Datos
# ============================================
# Para desarrollo local (sin Docker):
# DATABASE_PATH=futmondo_data.db
# Para Docker:
DATABASE_PATH=/app/data/futmondo_data.db

# ============================================
# Configuración de Caché
# ============================================
CACHE_DURATION_HOURS=24

# ============================================
# Configuración de Análisis
# ============================================
MAX_PLAYERS_TO_ANALYZE=600
MIN_TRANSACTIONS_FOR_ANALYSIS=1
REQUEST_DELAY_SECONDS=0.1

# ============================================
# Configuración de Salida
# ============================================
TOP_PROFITABLE_PLAYERS=20
SHOW_DETAILED_ANALYSIS=True

# ============================================
# Configuración del API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

OPENAI_API_KEY=your-open-ai-key
OPENAI_MODEL=gpt-4o-mini  # o gpt-4, gpt-3.5-turbo, etc.

NGROK_ENABLED=true
NGROK_AUTHTOKEN=your-ngrok-token

# ============================================
# PostgreSQL (Opcional - solo si usas PostgreSQL)
# ============================================
# Descomentar si quieres usar PostgreSQL en lugar de SQLite
# POSTGRES_DB=futmondo
# POSTGRES_USER=futmondo
# POSTGRES_PASSWORD=futmondo123
# PGADMIN_DEFAULT_EMAIL=admin@futmondo.com
# PGADMIN_DEFAULT_PASSWORD=admin123
